# Copy to .env, or run `make setup` to create it with generated secrets.

# Name shown in alerts, so you know which machine they came from.
HOST_NAME=my-server
TZ=UTC

# --- Alerts (ntfy) -----------------------------------------------------------
# Install the ntfy app (Android/iOS) or open https://ntfy.sh and subscribe to
# NTFY_TOPIC. Topics on ntfy.sh are public, so use a long random name:
# anyone who guesses it can read your alerts.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Access token, only needed for protected topics on a self-hosted ntfy server.
NTFY_TOKEN=

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Network -----------------------------------------------------------------
# Address Grafana and the OTLP ports listen on. 0.0.0.0 = your LAN.
BIND_ADDRESS=0.0.0.0
# Prometheus and Alertmanager have no login, so they listen on localhost only.
# Set to 0.0.0.0 to reach them from other machines.
ADMIN_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
# Where your apps send OpenTelemetry data (traces, metrics, logs).
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
# node-exporter runs on the host network so it sees the host's real network
# interfaces. Prometheus reaches it through the Docker bridge, so it can't be
# limited to 127.0.0.1.
NODE_EXPORTER_LISTEN=:9100

# --- Storage -----------------------------------------------------------------
# Metrics are deleted when either limit is reached.
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
# Logs (Loki) and traces (Tempo): see config/loki/loki.yml and config/tempo/tempo.yml.
