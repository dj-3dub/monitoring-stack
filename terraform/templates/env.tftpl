# Written by Terraform. Edit terraform.tfvars and run `make tf-apply` instead
# of changing this file; manual edits are overwritten on the next deploy.
HOST_NAME=${host_name}
TZ=${timezone}
NTFY_URL=${ntfy_url}
NTFY_TOPIC=${ntfy_topic}
NTFY_TOKEN=${ntfy_token}
GRAFANA_ADMIN_USER=${grafana_admin_user}
GRAFANA_ADMIN_PASSWORD=${grafana_admin_password}
BIND_ADDRESS=${bind_address}
ADMIN_BIND_ADDRESS=${admin_bind_address}
GRAFANA_PORT=${grafana_port}
PROMETHEUS_RETENTION_TIME=${prometheus_retention_time}
PROMETHEUS_RETENTION_SIZE=${prometheus_retention_size}
