    {
      "type": "table",
      "id": 10,
      "title": "Disks",
      "description": "Use per filesystem. 'Full in' projects the last 6 hours' trend; empty means the disk isn't filling.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "instance:node_filesystem_usage:percent{instance=\"$instance\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "node_filesystem_avail_bytes{instance=\"$instance\", fstype!~\"tmpfs|devtmpfs|ramfs|overlay|squashfs|nsfs|tracefs|fuse.lxcfs\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "node_filesystem_size_bytes{instance=\"$instance\", fstype!~\"tmpfs|devtmpfs|ramfs|overlay|squashfs|nsfs|tracefs|fuse.lxcfs\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "node_filesystem_avail_bytes{instance=\"$instance\", fstype!~\"tmpfs|devtmpfs|ramfs|overlay|squashfs|nsfs|tracefs|fuse.lxcfs\"} / -deriv(node_filesystem_avail_bytes{instance=\"$instance\", fstype!~\"tmpfs|devtmpfs|ramfs|overlay|squashfs|nsfs|tracefs|fuse.lxcfs\"}[6h]) > 0",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "mountpoint",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {
              "mountpoint": true,
              "Value #A": true,
              "Value #B": true,
              "Value #C": true,
              "Value #D": true
            },
            "indexByName": {
              "mountpoint": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "mountpoint": "Mount",
              "Value #A": "Used",
              "Value #B": "Free",
              "Value #C": "Size",
              "Value #D": "Full in"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Used",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
